# From Firebase console → Project settings → General → Your apps → Web app.
# These are EXPO_PUBLIC_* values, compiled into the app bundle. They are NOT
# secrets — Firebase web config is public by design and access is controlled by
# Firestore security rules. Never put a service-account key here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_REGION=europe-west1

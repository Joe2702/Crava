rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function levelIsPublished(levelId) {
      return exists(/databases/$(database)/documents/levels/$(levelId))
             && get(/databases/$(database)/documents/levels/$(levelId)).data.isPublished == true;
    }

    // Required drills are always idx 0-2 and the seed gives every drill the id
    // "<levelId>-<idx>", so their completion can be checked directly. Rules
    // cannot loop, so this is deliberately coupled to that id scheme — if the
    // seed's ids or the required set change, this must change with them.
    function requiredDrillsDone(uid, levelId) {
      return exists(/databases/$(database)/documents/users/$(uid)/drillCompletions/$(levelId + '-0'))
             && exists(/databases/$(database)/documents/users/$(uid)/drillCompletions/$(levelId + '-1'))
             && exists(/databases/$(database)/documents/users/$(uid)/drillCompletions/$(levelId + '-2'));
    }

    // ---- content: readable when published, never client-writable ----

    match /skills/{skillId} {
      allow read: if signedIn() && resource.data.isPublished == true;
      allow write: if false;
    }

    match /levels/{levelId} {
      allow read: if signedIn() && resource.data.isPublished == true;
      allow write: if false;
    }

    match /drills/{drillId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Playback ids. Unreadable by any client — Firestore rules cannot hide a
    // single field, so the ids live apart from levels/ rather than on it.
    match /levelVideos/{levelId} {
      allow read, write: if false;
    }

    // ---- per-user data ----

    match /users/{uid} {
      allow read: if isOwner(uid);

      // XP and streak are NOT stored. They are derived from levelCompletions,
      // so there is no counter to tamper with — the only thing a client can
      // write here is its own profile.
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'locale', 'city', 'notifEnabled', 'onboardedAt',
                                   'startLevelIdx', 'weeklyGoal']);
      allow delete: if isOwner(uid);

      // Ticking a drill grants nothing by itself; it is only an input to the
      // level-completion check below.
      match /drillCompletions/{drillId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }

      // Blocking is a store requirement for user content. It is per-user and
      // applied when the feed is read, so a block takes effect immediately
      // without touching anyone else's data.
      match /blocked/{blockedUid} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }

      // The earning event. Create-only, so a level can be cleared exactly once
      // and never re-awarded. completedAt must be the server's clock, which
      // stops a client backdating completions to manufacture a streak.
      match /levelCompletions/{levelId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
                      && levelIsPublished(levelId)
                      && requiredDrillsDone(uid, levelId)
                      && request.resource.data.keys().hasOnly(['completedAt'])
                      && request.resource.data.completedAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---- community ----

    // Posts carry no counter. A like count stored on the document would have to
    // be client-incrementable, and rules cannot tell an increment that
    // accompanies a like from one that does not, so it could be inflated
    // freely. The count is read with an aggregation query over likes/ instead,
    // which the client cannot forge.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['authorUid', 'authorName', 'body', 'skillId', 'createdAt'])
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 500
                    && request.resource.data.createdAt == request.time;
      // Edits are not offered, and allowing them would let a post be rewritten
      // after it was liked or reported.
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // Write-only from the client: anyone signed in can report, nobody can read
    // the reports back or tamper with one already filed.
    match /reports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

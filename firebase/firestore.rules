rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- content: readable when published, never client-writable ----

    match /skills/{skillId} {
      allow read: if signedIn() && resource.data.isPublished == true;
      allow write: if false;
    }

    match /levels/{levelId} {
      allow read: if signedIn() && resource.data.isPublished == true;
      allow write: if false;
    }

    match /drills/{drillId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Playback ids. Unreadable by any client — Firestore rules cannot hide a
    // single field, so the ids live apart from levels/ rather than on it.
    // getPlaybackUrl reads this with Admin privileges.
    match /levelVideos/{levelId} {
      allow read, write: if false;
    }

    // ---- per-user data ----

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Progress and entitlement are awarded server-side. The client may only
      // create its own doc at zero, and may only ever edit the profile fields
      // below — any write touching xp, streakCount, lastSessionDate or
      // entitlement is rejected, so progress cannot be minted from a phone.
      // The Cloud Function uses the Admin SDK, which bypasses these rules.
      allow create: if isOwner(uid)
                    && request.resource.data.xp == 0
                    && request.resource.data.streakCount == 0
                    && request.resource.data.entitlement == null;

      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'locale', 'city', 'notifEnabled', 'onboardedAt']);

      allow delete: if false;

      // Ticking a drill is harmless on its own — it grants nothing. The
      // function re-checks these server-side before awarding anything.
      match /drillCompletions/{drillId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }

      // Level completions are the record of what was earned, so only the
      // function may write them.
      match /levelCompletions/{levelId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

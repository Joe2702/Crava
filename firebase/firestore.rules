rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function levelIsPublished(levelId) {
      return exists(/databases/$(database)/documents/levels/$(levelId))
             && get(/databases/$(database)/documents/levels/$(levelId)).data.isPublished == true;
    }

    // Required drills are always idx 0-2 and the seed gives every drill the id
    // "<levelId>-<idx>", so their completion can be checked directly. Rules
    // cannot loop, so this is deliberately coupled to that id scheme — if the
    // seed's ids or the required set change, this must change with them.
    function requiredDrillsDone(uid, levelId) {
      return exists(/databases/$(database)/documents/users/$(uid)/drillCompletions/$(levelId + '-0'))
             && exists(/databases/$(database)/documents/users/$(uid)/drillCompletions/$(levelId + '-1'))
             && exists(/databases/$(database)/documents/users/$(uid)/drillCompletions/$(levelId + '-2'));
    }

    // ---- content: readable when published, never client-writable ----

    match /skills/{skillId} {
      allow read: if signedIn() && resource.data.isPublished == true;
      allow write: if false;
    }

    match /levels/{levelId} {
      allow read: if signedIn() && resource.data.isPublished == true;
      allow write: if false;
    }

    match /drills/{drillId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Playback ids. Unreadable by any client — Firestore rules cannot hide a
    // single field, so the ids live apart from levels/ rather than on it.
    match /levelVideos/{levelId} {
      allow read, write: if false;
    }

    // ---- per-user data ----

    match /users/{uid} {
      allow read: if isOwner(uid);

      // XP and streak are NOT stored. They are derived from levelCompletions,
      // so there is no counter to tamper with — the only thing a client can
      // write here is its own profile.
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'locale', 'city', 'notifEnabled', 'onboardedAt',
                                   'startLevelIdx', 'weeklyGoal']);
      allow delete: if isOwner(uid);

      // Which courses the learner has started. Account state rather than a
      // device preference, so My learning follows them to a new phone.
      // Enrolling grants nothing on its own — access comes from purchases.
      match /enrollments/{courseId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }

      // Courses the learner has bought. Readable by the owner and writable by
      // nobody: a purchase may only be recorded by a verified store receipt,
      // server-side. If a client could write here it could hand itself the
      // entire catalogue, which is exactly what this collection controls.
      match /purchases/{courseId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Ticking a step grants nothing by itself; it is only an input to the
      // lesson-completion check below.
      match /drillCompletions/{drillId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }


      // The earning event. Create-only, so a level can be cleared exactly once
      // and never re-awarded. completedAt must be the server's clock, which
      // stops a client backdating completions to manufacture a streak.
      match /levelCompletions/{levelId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
                      && levelIsPublished(levelId)
                      && requiredDrillsDone(uid, levelId)
                      && request.resource.data.keys().hasOnly(['completedAt'])
                      && request.resource.data.completedAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---- coaches marketplace ----

    // A coach profile is owned by a normal user account — the same account can
    // learn and coach, like an instructor on a course platform. ownerUid is null
    // until the profile is claimed, and only an admin sets it, because
    // "verified coach" has to mean somebody checked.
    match /coaches/{coachId} {
      allow read: if signedIn()
                  && (resource.data.isPublished == true || resource.data.ownerUid == request.auth.uid);
      // The owner may edit their own presentation, and nothing else. Notably
      // not isPublished or ownerUid, so a coach can neither publish themselves
      // nor hand the profile to someone else.
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['bio_en', 'bio_ar', 'city_en', 'city_ar', 'rateEgp']);
      allow create, delete: if false;

      match /slots/{slotId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Anyone signed in can apply to coach. Write-only from the client: an
    // applicant cannot read the queue back or change a decision.
    match /coachApplications/{uid} {
      allow create: if isOwner(uid)
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // A booking is a request, not a confirmation, so two people asking for the
    // same slot is not a conflict to resolve here — the coach confirms one.
    // No price is stored: a client-supplied figure could not be trusted, and
    // the coach's rate is already on the coach document.
    //
    // coachOwnerUid is denormalised onto the booking so both sides can query
    // their own rows with a filter Firestore can prove. Deriving it through the
    // coach document instead would need a get() the rules engine cannot
    // evaluate for a list query, and rules are not filters. It cannot be forged
    // because create checks it against the coach document.
    match /bookings/{bookingId} {
      allow read: if signedIn()
                  && (resource.data.userUid == request.auth.uid
                      || resource.data.coachOwnerUid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.userUid == request.auth.uid
                    && request.resource.data.status == 'requested'
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.keys().hasOnly(
                         ['userUid', 'coachId', 'coachOwnerUid', 'slotId', 'sessionType',
                          'status', 'createdAt'])
                    && request.resource.data.sessionType in ['form', 'live']
                    && request.resource.data.coachOwnerUid ==
                         get(/databases/$(database)/documents/coaches/$(request.resource.data.coachId))
                           .data.ownerUid;
      // Only the coach decides, and only the status moves. The requester cannot
      // confirm their own booking.
      allow update: if signedIn()
                    && resource.data.coachOwnerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['confirmed', 'declined'];
      allow delete: if signedIn() && resource.data.userUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
